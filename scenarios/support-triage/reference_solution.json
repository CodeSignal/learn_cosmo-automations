      "id": "n2",
      "name": "Fetch Open Tickets",
      "type": "postgres",
      "position": [
        -60,
        -120
      ],
      "credentialId": "cred_db",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ticket, accountId, subject, minutesOpen FROM tickets WHERE status = 'open'",
        "table": "",
        "columns": []
      }
    },
    {
      "id": "n3",
      "name": "List Accounts",
