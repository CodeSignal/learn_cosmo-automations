      "parameters": {
        "operation": "list",
        "baseId": "appSupport",
        "table": "Accounts",
        "fields": []
      }
    },
    {
      "id": "n4",
      "name": "One Row Per Ticket",
      "type": "removeDuplicates",
      "position": [
        160,
        -120
      ],
      "parameters": {
        "compare": "selectedFields",
        "fields": [
          "ticket"
        ]
      }
    },
    {
      "id": "n5",
      "name": "Attach Account",
      "type": "merge",
      "position": [
        380,
        0
      ],
      "parameters": {
        "mode": "combineByFields",
        "matchField": "accountId",
        "joinMode": "keepMatches",
        "includeUnpaired": false,
        "useDataOf": "input1"
      }
    },
    {
      "id": "n6",
      "name": "Route By Tier",
      "type": "switch",
      "position": [
        600,
        0
      ],
      "parameters": {
        "rules": [
          {
            "output": "enterprise",
            "left": "={{ $json.tier }}",
            "op": "equals",
            "right": "enterprise"
          },
          {
            "output": "standard",
            "left": "={{ $json.tier }}",
            "op": "equals",
            "right": "standard"
          }
        ],
        "fallback": "none",
        "allMatches": false
      }
    },
    {
      "id": "n7",
      "name": "Longest Open First",
      "type": "sort",
      "position": [
        820,
        -80
      ],
      "parameters": {
        "type": "fields",
        "fields": [
          {
            "field": "minutesOpen",
            "order": "descending"
          }
        ]
      }
    },
    {
      "id": "n8",
      "name": "Top Three",
      "type": "limit",
      "position": [
        1020,
        -80
      ],
      "parameters": {
        "maxItems": 3,
        "keep": "firstItems"
      }
    },
    {
      "id": "n9",
      "name": "Write Digest",
      "type": "googleSheets",
      "position": [
        1240,
        -80
      ],
      "credentialId": "cred_sheets",
      "parameters": {
        "operation": "append",
        "documentId": "sheetDigest2026",
        "sheetName": "Digest",
        "columns": [
          {
            "name": "Ticket",
            "value": "={{ $json.ticket }}"
          },
          {
            "name": "Company",
            "value": "={{ $json.company }}"
          },
          {
            "name": "MinutesOpen",
            "value": "={{ $json.minutesOpen }}"
          }
        ]
      }
    }
