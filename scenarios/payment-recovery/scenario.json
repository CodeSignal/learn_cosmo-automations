  "assertions": [
    {
      "id": "reads-failed-payments",
      "type": "httpCalled",
      "method": "POST",
      "path": "/__mock/db.internal.test/query",
      "times": 1,
      "message": "The payments query should run exactly once, not once per item."
    },
    {
      "id": "dedupes-invoices",
      "type": "nodeExists",
      "nodeType": "removeDuplicates",
      "message": "The query returns some invoices twice \u2014 they need de-duplicating."
    },
    {
      "id": "twelve-distinct-invoices",
      "type": "itemCount",
      "nodeType": "removeDuplicates",
      "port": "out",
      "comparison": "exactly",
      "count": 12,
      "message": "Fourteen rows come back and twelve of them are distinct invoices."
    },
    {
      "id": "loads-accounts",
      "type": "httpCalled",
      "method": "GET",
      "path": "/__mock/api.airtable.test/v0/appBilling/Accounts",
      "times": 1,
      "message": "The Airtable accounts table should be listed exactly once."
    },
    {
      "id": "joins-payments-to-accounts",
      "type": "nodeExists",
      "nodeType": "merge",
      "message": "The tier and the manager live on the account, not the payment."
    },
    {
      "id": "joins-on-account-id",
      "type": "expressionContains",
      "nodeType": "merge",
      "param": "matchField",
      "substring": "accountId",
      "message": "The join should match payments to accounts on accountId."
    },
    {
      "id": "routes-by-tier",
      "type": "nodeExists",
      "nodeType": "switch",
      "message": "Payments should be routed by tier."
    },
    {
      "id": "three-escalated",
      "type": "itemCount",
      "nodeType": "gmail",
      "port": "in",
      "comparison": "exactly",
      "count": 3,
      "message": "Only the three largest enterprise payments get a personal email."
    },
    {
      "id": "biggest-first",
      "type": "sinkPayloadMatches",
      "nodeType": "gmail",
      "match": {
        "to": "dana@acme-billing.test",
        "subject": "Failed payment: INV-9002 (12400 EUR)"
      },
      "message": "INV-9002 is the largest failed payment at 12400 and must be escalated."
    },
    {
      "id": "outreach-logged",
      "type": "httpCalled",
      "method": "POST",
      "path": "/__mock/sheets.test/v4/spreadsheets/sheetRecovery2026/values/Outreach:append",
      "times": 3,
      "message": "One sheet row per escalated payment: three rows, three calls."
    },
    {
      "id": "retries-in-batches",
      "type": "nodeExists",
      "nodeType": "loopOverItems",
      "message": "Mid-market retries should go two invoices at a time."
    },
    {
      "id": "four-retries-attempted",
      "type": "httpCalled",
      "method": "POST",
      "path": "/__mock/billing.acme.test/v1/invoices/INV-9006/retry",
      "times": 1,
      "message": "Each mid-market invoice should be retried once."
    },
    {
      "id": "dunning-queued",
      "type": "httpCalled",
      "method": "POST",
      "path": "/__mock/api.airtable.test/v0/appBilling/DunningQueue",
      "times": 2,
      "message": "The two self-serve payments should be queued for dunning."
    },
    {
      "id": "unknown-tier-flagged",
      "type": "sinkPayloadMatches",
      "nodeType": "slack",
      "match": {
        "channel": "#billing-alerts"
      },
      "message": "A tier no rule matches must be flagged, not silently dropped."
    },
    {
      "id": "one-summary-posted",
      "type": "sinkPayloadMatches",
      "nodeType": "slack",
      "match": {
        "channel": "#billing-ops",
        "text": "Recovery run: 9 payments handled, 28558 EUR still at risk"
      },
      "message": "One summary on #billing-ops with the count and the total at risk."
    },
    {
      "id": "no-node-errors",
      "type": "noNodeErrors",
      "message": "Every node should complete without an error."
    }
  ]
}
