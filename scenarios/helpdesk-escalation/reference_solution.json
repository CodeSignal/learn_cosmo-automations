      "credentialId": "cred_zendesk",
      "parameters": {
        "operation": "listTickets",
        "status": "open",
        "ticketId": "",
        "comment": ""
      }
    },
    {
      "id": "n3",
      "name": "Urgent Only",
      "type": "filter",
      "position": [
        200,
        0
      ],
      "parameters": {
        "combinator": "and",
        "conditions": [
          {
            "left": "={{ $json.priority }}",
            "op": "equals",
            "right": "urgent"
          }
        ]
      }
    },
    {
      "id": "n4",
      "name": "Escalate",
      "type": "zendesk",
      "position": [
        430,
        -90
      ],
      "credentialId": "cred_zendesk",
      "parameters": {
        "operation": "addComment",
        "status": "open",
        "ticketId": "={{ $json.id }}",
        "comment": "Escalated to the on-call engineer."
      }
    },
    {
      "id": "n5",
      "name": "Count Escalations",
      "type": "aggregate",
      "position": [
        430,
        110
      ],
      "parameters": {
        "mode": "summarize",
        "outputs": [
          {
            "as": "count",
            "op": "count"
          }
        ],
        "field": "data"
      }
    },
    {
      "id": "n6",
      "name": "Tell Support",
      "type": "slack",
      "position": [
        660,
        110
      ],
      "credentialId": "cred_slack",
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "#support-escalations",
        "text": "={{ $json.count }} urgent tickets escalated"
      }
    }
